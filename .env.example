# Copy to .env. Use a unique random password; do not commit .env.
DB_NAME=local_todo
DB_USER=local_todo
DB_PASSWORD=replace-with-a-long-random-password

# Bind to 127.0.0.1 for host-only access, or set to the host's LAN IP to permit LAN access.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080

# Native API development settings. Docker Compose sets DB_HOST=database itself.
DB_HOST=localhost
DB_PORT=5432
API_HOST=127.0.0.1
API_PORT=3000
