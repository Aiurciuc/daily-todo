# Copy to .env. Use a unique random password; do not commit .env.
DB_NAME=local_todo
DB_USER=local_todo
DB_PASSWORD=replace-with-a-long-random-password

# Bind to 127.0.0.1 for host-only access, or set to the host's LAN IP to permit LAN access.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080

# Native API development settings. Docker Compose sets DB_HOST=database itself.
DB_HOST=localhost
DB_PORT=5432
API_HOST=127.0.0.1
API_PORT=3000

# Local HTTP only. Set true for an HTTPS deployment.
AUTH_COOKIE_SECURE=false
# Session lifetime in seconds (60–2592000; default 7 days).
AUTH_SESSION_TTL_SECONDS=604800
# Behind an HTTPS proxy, configure AUTH_ORIGIN in the API environment to the
# exact public origin, e.g. https://todo.example.com (no trailing slash).
# AUTH_ORIGIN=https://todo.example.com
# Optional comma-separated exact IPs of controlled proxies (never client IPs).
# Proxy must overwrite X-Forwarded-For with one verified client IP. Without this,
# all clients behind the proxy share a single 10-attempt/minute auth limit.
# AUTH_TRUSTED_PROXY_IPS=172.20.0.3
